# 本地开发环境变量（复制本文件为 .dev.vars 并填写，勿提交 .dev.vars）
SESSION_SECRET=please-generate-a-long-random-secret
SITE_URL=https://blog.vobl.cn
# Lark（飞书）邮箱 SMTP —— 用于发送注册/登录验证码
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=465
SMTP_USER=your-email@your-domain.com
SMTP_PASS=your-password-or-auth-code
SMTP_FROM=your-email@your-domain.com
