---
/** 品牌 Logo：Segoe Script 连笔「vobl」字形（浅蓝渐变实心） */
import logoSvg from '../assets/logo-mark.svg?raw';

interface Props {
  size?: number;
}

const { size = 30 } = Astro.props;
---

<span class="logo-mark" style={`width:${size}px;height:${(size * 174.5) / 402.5}px`} set:html={logoSvg} />

<style>
  .logo-mark {
    display: inline-block;
    flex: none;
  }
  .logo-mark :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
