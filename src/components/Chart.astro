---
/** 轻量 SVG 线型图（无依赖）：浅蓝渐变线条 + 面积填充 + 数据点 */
interface Props {
  id: string;
  values: number[];
  labels: string[];
  height?: number;
}

const { id, values, labels, height = 150 } = Astro.props;
const W = 320;
const H = height;
const PAD = 22;
const max = Math.max(1, ...values);
const n = Math.max(2, values.length);

const px = (i: number) => PAD + (i * (W - PAD * 2)) / (n - 1);
const py = (v: number) => H - PAD - (v / max) * (H - PAD * 2);

const pts = values.map((v, i) => [px(i), py(v)] as const);

// Catmull-Rom → 贝塞尔平滑
let d = `M ${pts[0][0]} ${pts[0][1]}`;
for (let i = 0; i < pts.length - 1; i++) {
  const p0 = pts[Math.max(0, i - 1)];
  const p1 = pts[i];
  const p2 = pts[i + 1];
  const p3 = pts[Math.min(pts.length - 1, i + 2)];
  const c1x = p1[0] + (p2[0] - p0[0]) / 6;
  const c1y = p1[1] + (p2[1] - p0[1]) / 6;
  const c2x = p2[0] - (p3[0] - p1[0]) / 6;
  const c2y = p2[1] - (p3[1] - p1[1]) / 6;
  d += ` C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
}
const area = `${d} L ${pts[n - 1][0]} ${H - 4} L ${pts[0][0]} ${H - 4} Z`;
---

<div class="stats-chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={id}>
    <defs>
      <linearGradient id={`${id}-line`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#8ec5f7"></stop>
        <stop offset="1" stop-color="#2f6fd0"></stop>
      </linearGradient>
      <linearGradient id={`${id}-area`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#8ec5f7" stop-opacity="0.35"></stop>
        <stop offset="1" stop-color="#8ec5f7" stop-opacity="0.02"></stop>
      </linearGradient>
    </defs>

    {
      [0.25, 0.5, 0.75].map((f) => (
        <line
          class="grid-line"
          x1={PAD}
          x2={W - PAD}
          y1={PAD + f * (H - PAD * 2)}
          y2={PAD + f * (H - PAD * 2)}
        ></line>
      ))
    }

    <path class="area" d={area} fill={`url(#${id}-area)`}></path>
    <path class="line" d={d} stroke={`url(#${id}-line)`}></path>

    {
      pts.map(([x, y], i) => (
        <g>
          <circle class="dot" cx={x} cy={y} r="3"></circle>
          {labels[i] !== undefined && (
            <text class="axis-label" x={x} y={H - 6} text-anchor="middle">
              {labels[i]}
            </text>
          )}
        </g>
      ))
    }
  </svg>
</div>
