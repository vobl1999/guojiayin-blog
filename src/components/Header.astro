---
import { SITE } from '../config/site';
import Logo from './Logo.astro';

const user = Astro.locals.user;
const path = Astro.url.pathname;

const nav = [
  { label: '首页', i18n: 'nav.home', href: '/' },
  { label: '标签', i18n: 'nav.tags', href: '/tags' },
  { label: '归档', i18n: 'nav.archive', href: '/archive' },
  { label: '数据', i18n: 'nav.stats', href: '/stats' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const avatarHref = user?.avatarKey ? `/media/${user.avatarKey}` : null;
---

<div class="site-header">
  <div class="header-bar glass-strong">
    <a class="wordmark" href="/" aria-label="voblog">
      <span class="brand-mark"><Logo size={26} /></span>
      <span>{SITE.name}<span class="wordmark-dot">.</span></span>
      <span class="zh-name">{SITE.nameZh}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a class:list={['nav-link', { 'is-active': isActive(item.href) }]} href={item.href} data-i18n={item.i18n}>
            {item.label}
          </a>
        ))
      }
      <button class="lang-toggle" data-lang-toggle aria-label="Switch language">EN</button>
      <button class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
      <div class="auth-links">
        {
          user ? (
            <>
              <a class="nav-link" href={user.role === 'admin' ? '/admin' : '/me'}>
                {avatarHref ? (
                  <img class="avatar-mini" src={avatarHref} alt="" width="30" height="30" />
                ) : (
                  <span>{user.name || user.username}</span>
                )}
              </a>
            </>
          ) : (
            <>
              <a class="nav-link" href="/login" data-i18n="nav.login">登录</a>
              <a class="btn btn-primary btn-sm" href="/register" data-i18n="nav.register">注册</a>
            </>
          )
        }
      </div>
    </nav>
  </div>
</div>
