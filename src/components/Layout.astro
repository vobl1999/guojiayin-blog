---
import '../styles/global.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2';
import frauncesLatinItalic from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2';
import { SITE } from '../config/site';
import { UI, type Lang } from '../i18n/ui';
import Header from './Header.astro';
import Footer from './Footer.astro';

const LATIN_RANGE =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+2216,U+2218,U+222B,U+FEFF,U+FFFD';

const fontCss = `
@font-face{font-family:'Fraunces Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${frauncesLatin}) format('woff2-variations');unicode-range:${LATIN_RANGE}}
@font-face{font-family:'Fraunces Variable';font-style:italic;font-display:swap;font-weight:100 900;src:url(${frauncesLatinItalic}) format('woff2-variations');unicode-range:${LATIN_RANGE}}
@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatin}) format('woff2-variations');unicode-range:${LATIN_RANGE}}
`;

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = SITE.description, noindex = false } = Astro.props;
const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} — RSS`} href="/rss.xml" />
    <style is:global set:html={fontCss} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    {noindex && <meta name="robots" content="noindex" />}

    <script is:inline>
      document.documentElement.classList.add('js');
      // 老设备检测：IE 或老内核 → data-legacy，毛玻璃降级为实底、关动效
      (function () {
        try {
          var ua = navigator.userAgent || '';
          var legacy =
            /MSIE|Trident/.test(ua) ||
            (ua.indexOf('Safari') > -1 && ua.indexOf('Chrome') === -1 && parseInt((ua.match(/Version\/(\d+)/) || [])[1] || '0', 10) < 15);
          if (legacy) document.documentElement.setAttribute('data-legacy', '');
          var t = localStorage.getItem('theme-vobl');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到内容 Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <button class="back-top glass" data-back-top aria-label="Back to top">↑</button>
    <script>
      import { UI } from '../i18n/ui';

      // 滚动渐显
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.08 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // ── 中英界面切换 ───────────────────────────────────────
      const currentLang = (): 'zh' | 'en' => {
        try {
          return localStorage.getItem('blogb-lang') === 'en' ? 'en' : 'zh';
        } catch {
          return 'zh';
        }
      };
      const applyLang = () => {
        const lang = currentLang();
        const dict = UI[lang];
        document.documentElement.setAttribute('data-lang', lang);
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (key && dict[key]) el.textContent = dict[key];
        });
        document.querySelectorAll('[data-i18n-ph]').forEach((el) => {
          const key = el.getAttribute('data-i18n-ph');
          if (key && dict[key]) el.setAttribute('placeholder', dict[key]);
        });
        document.querySelectorAll('[data-lang-toggle]').forEach((btn) => {
          btn.textContent = lang === 'zh' ? 'EN' : '中文';
        });
      };
      applyLang();
      document.querySelectorAll('[data-lang-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          try {
            localStorage.setItem('blogb-lang', currentLang() === 'zh' ? 'en' : 'zh');
          } catch {}
          applyLang();
        });
      });

      // 主题切换
      const metaTheme = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      const applyMetaTheme = () => {
        if (!metaTheme) return;
        metaTheme.content =
          document.documentElement.getAttribute('data-theme') === 'dark' ? '#131110' : '#f4f1ea';
      };
      applyMetaTheme();
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const next =
            document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme-vobl', next);
          } catch {}
          applyMetaTheme();
        });
      });

      // 回到顶部
      const backTop = document.querySelector('[data-back-top]');
      if (backTop) {
        const onScrollTop = () => backTop.classList.toggle('is-visible', window.scrollY > 600);
        onScrollTop();
        window.addEventListener('scroll', onScrollTop, { passive: true });
        backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }
    </script>
  </body>
</html>
