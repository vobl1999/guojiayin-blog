---
import Layout from '../components/Layout.astro';
import { env } from '../lib/db';

if (Astro.locals.user) {
  return Astro.redirect('/me');
}
const next = Astro.url.searchParams.get('next') || '/';
const e = env(Astro.locals.runtime);
const sitekey = e.TURNSTILE_SITEKEY || '';
---

<Layout title="登录" noindex>
  <section class="container">
    <div class="glass auth-panel" data-reveal>
      <h1 class="auth-title" data-i18n="auth.loginTitle">登录</h1>
      <p class="muted small" style="margin-bottom: 1.6rem" data-i18n="auth.loginSub">密码登录，或发送邮箱验证码登录。</p>

      <div class="field">
        <label class="field-label" for="li-email" data-i18n="auth.email">邮箱</label>
        <input class="input" id="li-email" type="email" autocomplete="email" required placeholder="you@example.com" />
      </div>

      {sitekey && (
        <div class="field">
          <div class="cf-turnstile" data-sitekey={sitekey} data-theme="auto"></div>
        </div>
      )}
      <script is:inline src={sitekey ? 'https://challenges.cloudflare.com/turnstile/v0/api.js' : undefined} async defer></script>

      <div id="pw-mode">
        <div class="field">
          <label class="field-label" for="li-password" data-i18n="auth.password">密码</label>
          <input class="input" id="li-password" type="password" autocomplete="current-password" placeholder="你的密码" data-i18n-ph="auth.passwordPh" />
        </div>
        <p class="form-error" data-msg></p>
        <div style="display:flex;gap:0.8rem;flex-wrap:wrap;align-items:center">
          <button class="btn btn-primary" id="li-pw-btn" type="button" data-i18n="auth.loginBtn">登录</button>
          <button class="btn btn-ghost" id="li-code-switch" type="button" data-i18n="auth.codeLogin">用验证码登录</button>
        </div>
      </div>

      <div id="code-mode" class="hidden">
        <div class="field">
          <label class="field-label" for="li-code" data-i18n="auth.code">邮箱验证码</label>
          <input class="input" id="li-code" type="text" inputmode="numeric" maxlength="6" placeholder="6 位数字" data-i18n-ph="auth.codePh" />
        </div>
        <p class="form-error" data-msg2></p>
        <div style="display:flex;gap:0.8rem;flex-wrap:wrap;align-items:center">
          <button class="btn btn-primary" id="li-code-btn" type="button" data-i18n="auth.verifyLogin">验证并登录</button>
          <button class="btn btn-ghost" id="li-send-btn" type="button" data-i18n="auth.sendCode">发送验证码</button>
          <button class="btn btn-ghost" id="li-pw-switch" type="button" data-i18n="auth.pwLogin">用密码登录</button>
        </div>
      </div>

      <p class="small muted mt-2"><span data-i18n="auth.noAccount">还没有账号？</span><a href={`/register?next=${encodeURIComponent(next)}`} style="color:var(--gold)" data-i18n="auth.toRegister">去注册</a></p>
    </div>
  </section>
</Layout>

<script>
  const next = new URLSearchParams(location.search).get('next') || '/';
  const email = () => (document.querySelector<HTMLInputElement>('#li-email')!).value.trim();
  const pwMode = document.querySelector<HTMLElement>('#pw-mode')!;
  const codeMode = document.querySelector<HTMLElement>('#code-mode')!;
  const msg1 = document.querySelector<HTMLElement>('[data-msg]')!;
  const msg2 = document.querySelector<HTMLElement>('[data-msg2]')!;

  const post = async (payload: Record<string, unknown>) => {
    const cfToken = (window as unknown as { turnstile?: { getResponse: () => string } }).turnstile?.getResponse() ?? '';
    const res = await fetch('/api/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ...payload, cfToken }),
    });
    return { ok: res.ok, data: (await res.json()) as { error?: string; dev?: boolean } };
  };

  document.querySelector('#li-code-switch')!.addEventListener('click', () => {
    pwMode.classList.add('hidden');
    codeMode.classList.remove('hidden');
    msg2.textContent = '';
  });
  document.querySelector('#li-pw-switch')!.addEventListener('click', () => {
    codeMode.classList.add('hidden');
    pwMode.classList.remove('hidden');
    msg1.textContent = '';
  });

  document.querySelector('#li-pw-btn')!.addEventListener('click', async () => {
    const password = (document.querySelector<HTMLInputElement>('#li-password')!).value;
    if (!password) return;
    const { ok, data } = await post({ mode: 'password', email: email(), password });
    if (ok) location.href = next;
    else msg1.textContent = data.error || '登录失败。';
  });

  document.querySelector('#li-send-btn')!.addEventListener('click', async () => {
    const e = email();
    if (!e) return;
    msg2.textContent = '';
    const { ok, data } = await post({ mode: 'code', step: 'send', email: e });
    msg2.textContent = ok
      ? (data.dev ? '（开发模式）验证码已打印在服务端控制台。' : '验证码已发送，请查收邮件。')
      : (data.error || '发送失败。');
  });

  document.querySelector('#li-code-btn')!.addEventListener('click', async () => {
    const code = (document.querySelector<HTMLInputElement>('#li-code')!).value.trim();
    if (!code) return;
    const { ok, data } = await post({ mode: 'code', step: 'verify', email: email(), code });
    if (ok) location.href = next;
    else msg2.textContent = data.error || '验证失败。';
  });
</script>
