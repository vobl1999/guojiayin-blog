---
import Layout from '../components/Layout.astro';
import { env } from '../lib/db';
import { listPostsByAuthor, countCommentsForUser, uiLang } from '../lib/posts';
import { fmtDate, avatarUrl } from '../lib/format';

if (!Astro.locals.user) {
  return Astro.redirect('/login?next=/me');
}
const user = Astro.locals.user;
const e = env(Astro.locals.runtime);
const posts = await listPostsByAuthor(e, user.id, uiLang(Astro.cookies.get('blogb_lang')?.value));
const commentCount = await countCommentsForUser(e, user.id);
const genderText = user.gender === 'male' ? '男' : user.gender === 'female' ? '女' : user.gender === 'other' ? '其他' : '';
---

<Layout title="个人中心" noindex>
  <section class="container section" style="padding-bottom: 1rem">
    <div class="glass profile-hero" data-reveal>
      {user.avatarKey ? (
        <img class="profile-avatar" src={avatarUrl(user.avatarKey) ?? ''} alt="头像" width="120" height="120" />
      ) : (
        <div class="profile-avatar"></div>
      )}
      <div class="profile-info">
        <h1 class="profile-name">{user.name || user.username}</h1>
        <div class="profile-meta">
          <a class="gender-badge" href={`/u/${user.username}`}>主页 /u/{user.username}</a>
          {genderText && <span class="gender-badge">{genderText}</span>}
          {user.role === 'admin' && <span class="gender-badge" style="color:var(--gold);border-color:var(--gold)">管理员</span>}
          <span class="small muted">注册于 {fmtDate(user.createdAt)}</span>
        </div>
        <div class="profile-meta mt-1">
          <span class="small muted">{posts.length} 篇文章</span>
          <span class="small muted">{commentCount} 条评论</span>
        </div>
        {user.role === 'admin' && (
          <div class="mt-1"><a class="btn btn-primary btn-sm" href="/admin" data-i18n="me.enterAdmin">进入管理后台</a></div>
        )}
      </div>
    </div>
  </section>

  <section class="container section" style="padding-top: 2rem">
    <div class="admin-wrap">
      <div class="glass glass-card" data-reveal>
        <h2 class="display-2" style="margin-bottom: 1.4rem; font-size: 1.4rem" data-i18n="me.profile">账号设置</h2>

        <form id="profile-form" style="margin-bottom: 2rem">
          <div class="field">
            <label class="field-label" data-i18n="me.email">邮箱（登录账号）</label>
            <input class="input" value={user.email} disabled />
          </div>
          <div class="field">
            <label class="field-label" for="pf-name" data-i18n="me.name">昵称</label>
            <input class="input" id="pf-name" name="name" maxlength="30" value={user.name} />
          </div>
          <div class="field">
            <label class="field-label" for="pf-gender" data-i18n="me.gender">性别</label>
            <select class="select" id="pf-gender" name="gender">
              <option value="" selected={!user.gender} data-i18n="me.genderPrivate">不公开</option>
              <option value="male" selected={user.gender === 'male'} data-i18n="me.genderMale">男</option>
              <option value="female" selected={user.gender === 'female'} data-i18n="me.genderFemale">女</option>
              <option value="other" selected={user.gender === 'other'} data-i18n="me.genderOther">其他</option>
            </select>
          </div>
          <div class="field">
            <label class="field-label" for="pf-bio" data-i18n="me.bio">简介</label>
            <textarea class="textarea" id="pf-bio" name="bio" rows="3" maxlength="200" placeholder="一句话介绍自己" data-i18n-ph="me.bioPh">{user.bio}</textarea>
          </div>
          <p class="form-ok" data-pf-ok></p>
          <button class="btn btn-primary" type="submit" data-i18n="me.save">保存资料</button>
        </form>

        <form id="avatar-form" style="margin-bottom: 2rem">
          <div class="field">
            <label class="field-label" for="pf-avatar" data-i18n="me.avatar">更换头像</label>
            <input class="input" id="pf-avatar" name="avatar" type="file" accept="image/jpeg,image/png,image/webp" />
            <span class="form-hint" data-i18n="me.avatarHint">JPG/PNG/WebP，≤ 2MB，建议正方形。</span>
          </div>
          <button class="btn btn-ghost" type="submit" data-i18n="me.upload">上传头像</button>
        </form>

        <form id="pw-form">
          <div class="field">
            <label class="field-label" for="pw-old" data-i18n="me.oldPw">当前密码</label>
            <input class="input" id="pw-old" type="password" autocomplete="current-password" />
          </div>
          <div class="field">
            <label class="field-label" for="pw-new" data-i18n="me.newPw">新密码</label>
            <input class="input" id="pw-new" type="password" autocomplete="new-password" minlength="8" />
          </div>
          <p class="form-ok" data-pw-ok></p>
          <button class="btn btn-ghost" type="submit" data-i18n="me.changePw">修改密码</button>
        </form>
      </div>

      <div data-reveal>
        <h2 class="display-2" style="margin-bottom: 1.2rem; font-size: 1.4rem" data-i18n="me.posts">我的文章</h2>
        <div class="post-list">
          {
            posts.length === 0 ? (
              <p class="muted">还没有发布文章。</p>
            ) : (
              posts.map((post) => (
                <article class="glass glass-card post-card card-hover">
                  <div class="post-card-main">
                    <h3 class="post-title" style="font-size: 1.15rem"><a href={`/post/${post.slug}`}>{post.title}</a></h3>
                    <p class="post-meta"><span>{fmtDate(post.published_at)}</span><span>{post.comment_count ?? 0} 条评论</span></p>
                  </div>
                </article>
              ))
            )
          }
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const pfForm = document.querySelector<HTMLFormElement>('#profile-form')!;
  const pfOk = document.querySelector<HTMLElement>('[data-pf-ok]')!;
  pfForm.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const fd = new FormData(pfForm);
    const res = await fetch('/api/me/update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: fd.get('name'),
        gender: fd.get('gender') || null,
        bio: fd.get('bio'),
      }),
    });
    const data = (await res.json()) as { error?: string };
    pfOk.textContent = res.ok ? '已保存 ✓' : (data.error || '保存失败');
    if (res.ok) setTimeout(() => location.reload(), 900);
  });

  const avatarForm = document.querySelector<HTMLFormElement>('#avatar-form')!;
  avatarForm.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const input = document.querySelector<HTMLInputElement>('#pf-avatar')!;
    if (!input.files?.length) return;
    const fd = new FormData();
    fd.append('avatar', input.files[0]);
    const res = await fetch('/api/me/avatar', { method: 'POST', body: fd });
    const data = (await res.json()) as { error?: string };
    if (res.ok) location.reload();
    else alert(data.error || '上传失败');
  });

  const pwForm = document.querySelector<HTMLFormElement>('#pw-form')!;
  const pwOk = document.querySelector<HTMLElement>('[data-pw-ok]')!;
  pwForm.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const fd = new FormData(pwForm);
    const res = await fetch('/api/me/password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ old: fd.get('pw-old'), next: fd.get('pw-new') }),
    });
    const data = (await res.json()) as { error?: string };
    pwOk.textContent = res.ok ? '密码已修改 ✓' : (data.error || '修改失败');
  });
</script>
