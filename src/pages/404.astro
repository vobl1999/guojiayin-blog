---
import Layout from '../components/Layout.astro';
---

<Layout title="页面不存在" noindex>
  <section class="container-narrow section text-center">
    <div class="glass glass-card" data-reveal style="padding: 4rem 2rem">
      <p class="label">404</p>
      <h1 class="display-1" style="margin-block: 1rem" data-i18n="notfound.title">这一页不存在。</h1>
      <p class="muted" data-i18n="notfound.sub">它可能被移动或删除了。</p>
      <div style="margin-top: 1.6rem; display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap">
        <a class="btn btn-primary" href="/" data-i18n="notfound.home">回到博客首页</a>
        <a class="btn btn-ghost" href="https://www.vobl.cn" target="_blank" rel="noopener noreferrer" data-i18n="notfound.portfolio">回到个人主页</a>
      </div>
    </div>
  </section>
</Layout>
